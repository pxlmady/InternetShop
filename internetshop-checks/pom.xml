<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.internetshop</groupId>
        <artifactId>internetshop</artifactId>
        <version>1.0.0</version>
    </parent>

    <!-- Checks: консольні перевірки (аналог CourseDemo.Checks). Запускаються в mvn verify. -->
    <artifactId>internetshop-checks</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.internetshop</groupId>
            <artifactId>internetshop-webapi</artifactId>
        </dependency>
        <dependency>
            <groupId>com.internetshop</groupId>
            <artifactId>internetshop-infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.internetshop</groupId>
            <artifactId>internetshop-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.internetshop</groupId>
            <artifactId>internetshop-domain</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- На фазі verify запускає Checks; якщо хоч одна перевірка не пройде, збірка завершиться помилкою. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>run-checks</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.internetshop.checks.Checks</mainClass>
                            <arguments>
                                <!-- Корінь проєкту: потрібен для перевірки меж шарів за вихідним кодом. -->
                                <argument>${project.basedir}/..</argument>
                            </arguments>
                            <cleanupDaemonThreads>false</cleanupDaemonThreads>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
